<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="smart_list_view_pro.LayoutsButton">
        <button type="button"
                t-ref="this.buttonRef"
                class="btn btn-secondary o_smart_list_layouts_button"
                t-att-class="{ 'o_smart_list_modified': this.isModified }"
                t-att-title="this.title"
                aria-label="Layouts"
                aria-haspopup="dialog"
                t-att-aria-expanded="this.popover.isOpen ? 'true' : 'false'"
                t-on-click="this.onClick">
            <i class="fa fa-columns" aria-hidden="true"/>
            <span class="d-none d-md-inline ms-1">Layouts</span>
            <span t-if="this.isModified" class="o_smart_list_modified_dot ms-1" aria-hidden="true"/>
            <span t-if="this.isModified" class="visually-hidden">Unsaved layout changes</span>
        </button>
    </t>

    <t t-name="smart_list_view_pro.LayoutPanel">
        <div class="o_smart_list_panel p-3" role="dialog" aria-labelledby="o_smart_list_panel_title" t-ref="this.rootRef">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h5 id="o_smart_list_panel_title" class="mb-0">List layouts</h5>
                <button type="button" class="btn-close" aria-label="Close" t-on-click="() => this.props.close()"/>
            </div>
            <div t-if="this.props.isGrouped" class="alert alert-info py-2 mb-2 o_smart_list_grouped_notice" role="status">
                Layouts cannot be changed while the list is grouped. Remove the grouping to edit columns.
            </div>
            <section t-else="" class="o_smart_list_editor mb-3" aria-labelledby="o_smart_list_columns_title">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <h6 id="o_smart_list_columns_title" class="text-muted text-uppercase small mb-0">Columns</h6>
                    <small class="text-muted">Width (px)</small>
                </div>
                <ul class="list-unstyled mb-0 o_smart_list_columns">
                    <li t-foreach="this.rows" t-as="row" t-key="row.field"
                        class="d-flex align-items-center gap-1 py-1 o_smart_list_column"
                        t-att-data-field="row.field">
                        <div class="form-check flex-grow-1 mb-0 o_smart_list_column_label">
                            <input type="checkbox" class="form-check-input"
                                   t-attf-id="o_smart_list_col_{{row.field}}"
                                   t-att-checked="row.visible"
                                   t-att-disabled="row.locked"
                                   t-att-title="row.locked ? row.lockedLabel : undefined"
                                   t-att-aria-label="row.showLabel"
                                   t-on-change="(ev) => this.onToggle(row.field, ev.target.checked)"/>
                            <label class="form-check-label text-truncate d-block" t-attf-for="o_smart_list_col_{{row.field}}" t-out="row.label"/>
                        </div>
                        <button type="button" class="btn btn-sm btn-light o_smart_list_move_up"
                                t-att-disabled="row.isFirst"
                                t-att-aria-label="row.moveUpLabel" t-att-title="row.moveUpLabel"
                                t-on-click="() => this.onMove(row.field, row_index, -1)">
                            <i class="fa fa-arrow-up" aria-hidden="true"/>
                        </button>
                        <button type="button" class="btn btn-sm btn-light o_smart_list_move_down"
                                t-att-disabled="row.isLast"
                                t-att-aria-label="row.moveDownLabel" t-att-title="row.moveDownLabel"
                                t-on-click="() => this.onMove(row.field, row_index, 1)">
                            <i class="fa fa-arrow-down" aria-hidden="true"/>
                        </button>
                        <input type="number" class="form-control form-control-sm o_smart_list_width"
                               t-att-min="this.MIN_COLUMN_WIDTH" t-att-max="this.MAX_COLUMN_WIDTH" step="10"
                               placeholder="Auto"
                               t-att-value="row.width ?? ''"
                               t-att-aria-label="row.widthLabel"
                               t-on-change="(ev) => this.onWidthChange(row.field, ev)"/>
                    </li>
                </ul>
                <p t-if="!this.rows.length" class="text-muted mb-0">This list has no columns that can be arranged.</p>
            </section>

            <div t-if="this.isModified" class="d-flex align-items-start gap-2 mb-3 o_smart_list_modified_notice" role="status">
                <div class="flex-grow-1 small">
                    <strong>Unsaved layout changes</strong>
                    <div class="text-muted">They apply to this list until you leave it or reload the page.</div>
                </div>
                <div class="d-flex flex-column gap-1">
                    <button t-if="this.appliedPreset and this.canEdit(this.appliedPreset)" type="button"
                            class="btn btn-sm btn-primary o_smart_list_update"
                            t-att-disabled="this.state.busy" t-on-click="this.onUpdateApplied">
                        Save changes
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary o_smart_list_reset" t-on-click="this.onReset">Reset</button>
                </div>
            </div>
            <div t-elif="this.applied" class="d-flex align-items-start gap-2 mb-3 o_smart_list_applied_notice" role="status">
                <div class="flex-grow-1 small">
                    Layout <strong t-out="this.applied.name"/> is applied.
                    <div t-if="this.appliedPreset and this.appliedPreset.is_default" class="text-muted">It is applied automatically when this list opens.</div>
                    <div t-elif="this.appliedPreset and this.canEdit(this.appliedPreset)" class="text-muted">Click the star to apply it every time this list opens.</div>
                </div>
                <button type="button" class="btn btn-sm btn-secondary o_smart_list_reset" t-on-click="this.onReset">Reset</button>
            </div>

            <div class="mb-3">
                <div t-if="this.state.form and this.state.form.mode === 'new'" class="d-flex gap-1 o_smart_list_name_form">
                    <input type="text" class="form-control form-control-sm o_smart_list_name_input"
                           t-att-value="this.state.form.name" t-on-input="this.onNameInput" t-att-maxlength="this.NAME_MAX_LENGTH"
                           placeholder="Layout name" aria-label="Layout name" t-ref="this.autofocusRef"
                           t-on-keydown="this.onFormKeydown"/>
                    <button type="button" class="btn btn-sm btn-primary o_smart_list_form_save"
                            t-att-disabled="this.state.busy" t-on-click="this.onSubmitForm">Save</button>
                    <button type="button" class="btn btn-sm btn-secondary o_smart_list_form_cancel"
                            t-on-click="this.onCancelForm">Cancel</button>
                </div>
                <button t-else="" type="button" class="btn btn-sm btn-primary o_smart_list_save_new"
                        t-att-disabled="this.state.busy or this.state.loading" t-on-click="this.onStartSaveNew">
                    <i class="fa fa-floppy-o me-1" aria-hidden="true"/>Save as new layout
                </button>
            </div>

            <section class="o_smart_list_section_personal mb-2" aria-labelledby="o_smart_list_personal_title" t-att-aria-busy="this.state.loading ? 'true' : 'false'">
                <h6 id="o_smart_list_personal_title" class="text-muted text-uppercase small mb-1">My layouts</h6>
                <p t-if="this.state.loading" class="text-muted mb-0">Loading…</p>
                <p t-elif="!this.personalPresets.length" class="o_smart_list_empty mb-0">No saved layouts yet. Adjust the columns and save your first layout.</p>
                <ul t-else="" class="list-unstyled mb-0">
                    <t t-foreach="this.personalPresets" t-as="preset" t-key="preset.id">
                        <t t-call="smart_list_view_pro.PresetItem"/>
                    </t>
                </ul>
            </section>
            <section class="o_smart_list_section_shared" aria-labelledby="o_smart_list_shared_title" t-att-aria-busy="this.state.loading ? 'true' : 'false'">
                <h6 id="o_smart_list_shared_title" class="text-muted text-uppercase small mb-1">Shared layouts</h6>
                <p t-if="this.state.loading" class="text-muted mb-0">Loading…</p>
                <p t-elif="!this.sharedPresets.length" class="o_smart_list_shared_empty mb-0 text-muted">No shared layouts for this list.</p>
                <ul t-else="" class="list-unstyled mb-0">
                    <t t-foreach="this.sharedPresets" t-as="preset" t-key="preset.id">
                        <t t-call="smart_list_view_pro.PresetItem"/>
                    </t>
                </ul>
            </section>
        </div>
    </t>

    <t t-name="smart_list_view_pro.PresetItem">
        <li class="d-flex align-items-center gap-1 py-1 o_smart_list_preset" t-att-data-preset-id="preset.id">
            <t t-if="this.state.form and this.state.form.mode === 'rename' and this.state.form.id === preset.id">
                <input type="text" class="form-control form-control-sm o_smart_list_name_input"
                       t-att-value="this.state.form.name" t-on-input="this.onNameInput" t-att-maxlength="this.NAME_MAX_LENGTH"
                       aria-label="Layout name" t-ref="this.autofocusRef" t-on-keydown="this.onFormKeydown"/>
                <button type="button" class="btn btn-sm btn-primary o_smart_list_form_save"
                        t-att-disabled="this.state.busy" t-on-click="this.onSubmitForm">Save</button>
                <button type="button" class="btn btn-sm btn-secondary o_smart_list_form_cancel"
                        t-on-click="this.onCancelForm">Cancel</button>
            </t>
            <t t-elif="this.state.confirmDeleteId === preset.id">
                <span class="flex-grow-1 small text-truncate">Delete <strong t-out="preset.name"/>?</span>
                <button type="button" class="btn btn-sm btn-danger o_smart_list_confirm_delete"
                        t-att-disabled="this.state.busy" t-on-click="() => this.onConfirmDelete(preset)">Delete</button>
                <button type="button" class="btn btn-sm btn-secondary o_smart_list_cancel_delete"
                        t-on-click="this.onCancelDelete">Cancel</button>
            </t>
            <t t-else="">
                <div class="flex-grow-1 d-flex flex-column align-items-start o_smart_list_preset_label">
                    <button type="button" class="btn btn-link btn-sm p-0 mw-100 text-start text-truncate o_smart_list_apply"
                            t-att-disabled="!preset.valid"
                            t-att-aria-label="this.actionLabel('apply', preset)"
                            t-att-title="preset.name"
                            t-on-click="() => this.onApply(preset)">
                        <t t-out="preset.name"/>
                        <small t-if="!preset.valid" class="text-muted ms-1">(no longer applicable)</small>
                    </button>
                    <!-- Badges on their own line: the name and the actions keep their room. -->
                    <div t-if="preset.is_default or this.isApplied(preset)" class="d-flex flex-wrap gap-1">
                        <span t-if="preset.is_default" class="badge text-bg-warning o_smart_list_default_badge"
                              t-att-title="preset.visibility === 'shared' ? 'Applied when a user without a default of their own opens this list' : 'Applied when you open this list'">
                            <t t-if="preset.visibility === 'shared'">Team default</t>
                            <t t-else="">Default</t>
                        </span>
                        <span t-if="this.isApplied(preset)" class="badge text-bg-light o_smart_list_applied_badge">Applied</span>
                    </div>
                </div>
                <t t-set="editable" t-value="this.canEdit(preset)"/>
                <button t-if="this.canSetDefault(preset)" type="button" class="btn btn-sm btn-light o_smart_list_default"
                        t-att-class="{ 'text-warning': preset.is_default }"
                        t-att-disabled="this.state.busy"
                        t-att-aria-pressed="preset.is_default ? 'true' : 'false'"
                        t-att-aria-label="this.actionLabel(preset.is_default ? 'clearDefault' : 'setDefault', preset)"
                        t-att-title="this.actionLabel(preset.is_default ? 'clearDefault' : 'setDefault', preset)"
                        t-on-click="() => this.onToggleDefault(preset)">
                    <i t-attf-class="fa {{ preset.is_default ? 'fa-star' : 'fa-star-o' }}" aria-hidden="true"/>
                </button>
                <button t-if="editable" type="button" class="btn btn-sm btn-light o_smart_list_rename"
                        t-att-disabled="this.state.busy" t-att-aria-label="this.actionLabel('rename', preset)"
                        t-att-title="this.actionLabel('rename', preset)" t-on-click="() => this.onStartRename(preset)">
                    <i class="fa fa-pencil" aria-hidden="true"/>
                </button>
                <button type="button" class="btn btn-sm btn-light o_smart_list_duplicate"
                        t-att-disabled="this.state.busy or !preset.valid" t-att-aria-label="this.actionLabel('duplicate', preset)"
                        t-att-title="this.actionLabel('duplicate', preset)" t-on-click="() => this.onDuplicate(preset)">
                    <i class="fa fa-clone" aria-hidden="true"/>
                </button>
                <t t-if="preset.visibility === 'personal'">
                    <button t-if="this.state.isAdmin" type="button" class="btn btn-sm btn-light o_smart_list_publish"
                            t-att-disabled="this.state.busy or !preset.valid" t-att-aria-label="this.actionLabel('publish', preset)"
                            t-att-title="this.actionLabel('publish', preset)" t-on-click="() => this.onPublish(preset)">
                        <i class="fa fa-share-alt" aria-hidden="true"/>
                    </button>
                    <button t-if="editable" type="button" class="btn btn-sm btn-light o_smart_list_delete"
                            t-att-disabled="this.state.busy" t-att-aria-label="this.actionLabel('delete', preset)"
                            t-att-title="this.actionLabel('delete', preset)" t-on-click="() => this.onAskDelete(preset)">
                        <i class="fa fa-trash" aria-hidden="true"/>
                    </button>
                </t>
                <button t-elif="editable" type="button" class="btn btn-sm btn-light o_smart_list_unpublish"
                        t-att-disabled="this.state.busy" t-att-aria-label="this.actionLabel('unpublish', preset)"
                        t-att-title="this.actionLabel('unpublish', preset)" t-on-click="() => this.onUnpublish(preset)">
                    <i class="fa fa-eye-slash" aria-hidden="true"/>
                </button>
            </t>
        </li>
    </t>

</templates>
